<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Wavelit.App</RootNamespace>
    <AssemblyName>Wavelit</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wavelit.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WebView2 ships separate x64/arm64 loaders; a specific RID keeps the output lean. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wavelit.Core\Wavelit.Core.csproj" />
    <!-- Built first, then copied into create\ (its own folder keeps its dependencies separate). -->
    <ProjectReference Include="..\Wavelit.Create\Wavelit.Create.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyCreateHelper" AfterTargets="Build">
    <ItemGroup>
      <CreateHelperFiles Include="..\Wavelit.Create\bin\$(Configuration)\net10.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(CreateHelperFiles)" DestinationFiles="@(CreateHelperFiles->'$(OutDir)create\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishCreateHelper" AfterTargets="Publish">
    <MSBuild Projects="..\Wavelit.Create\Wavelit.Create.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)'))create\" />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\wavelit.ico" />
    <Resource Include="Assets\wavelit-256.png" />
    <Resource Include="Assets\BuiltIn\*.jpg" />
    <Resource Include="Assets\Overlays\*.jpg" />
    <Content Include="Web\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
