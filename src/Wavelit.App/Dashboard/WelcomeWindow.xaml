<ui:FluentWindow x:Class="Wavelit.App.Dashboard.WelcomeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Wavelit.App.Dashboard.ViewModels"
                 Title="Welcome to Wavelit"
                 Width="760" Height="720" MinWidth="640" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="/Assets/wavelit.ico"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:WelcomeViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Welcome to Wavelit" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,8,32,16">
                <TextBlock Text="Let's set up your desktop" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Three quick choices. You can change any of them later." Style="{StaticResource PageSubtitle}" />

                <!-- 1. Wallpaper -->
                <TextBlock Text="1. Pick a starting wallpaper" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="It changes behind this window as you click." Style="{StaticResource Caption}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Starters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StarterOption}">
                            <Button Margin="0,0,8,8" Padding="0" Height="118" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Item.Title}">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    <Border VerticalAlignment="Bottom" Background="#99000000" Padding="8,4">
                                        <TextBlock Text="{Binding Item.Title}" Foreground="White" FontWeight="SemiBold" />
                                    </Border>
                                    <Border BorderThickness="3" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 2. Screens -->
                <StackPanel Visibility="{Binding HasMultipleDisplays, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="2. Your screens" Style="{StaticResource SectionHeader}" />
                    <ui:CardControl Icon="{ui:SymbolIcon ArrowMaximize24}" Margin="0,0,0,4">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="Extend across my screens" FontWeight="SemiBold" />
                                <TextBlock Text="One wallpaper continues across all your monitors, lined up with your display arrangement. Turn off for the same picture on each screen."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding Extend}" AutomationProperties.Name="Extend across my screens" />
                    </ui:CardControl>
                </StackPanel>

                <!-- 3. Extras -->
                <TextBlock Text="3. Optional extras" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                            <TextBlock Text="Your live wallpaper is there every time you sign in." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon CursorHover24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Overlay: stardust" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="A few specks of soft dust over your wallpaper that part around your mouse. Turn it on and move the mouse over the desktop to try it; eleven more on the Overlays page." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding Interactive}" AutomationProperties.Name="Stardust overlay" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Sparkle24}" Margin="0,0,0,4" IsEnabled="{Binding LocalAi.GpuSupported}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Local AI: create wallpapers on this PC" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                <Run Text="Private and unlimited. Downloads in the background (" /><Run Text="{Binding LocalAi.SizeText, Mode=OneWay}" /><Run Text="). " /><Run Text="{Binding LocalAi.GpuText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Not needed for the free cloud generator; you can add it later in Settings." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding WantLocalAi}" AutomationProperties.Name="Download Local AI" />
                </ui:CardControl>
                <CheckBox Margin="52,6,0,0" IsChecked="{Binding AcceptedLicense}"
                          Visibility="{Binding WantLocalAi, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap">
                        I agree to the model's licence (SDXL-Lightning,
                        <Hyperlink Command="{Binding LocalAi.OpenLicenseCommand}">CreativeML Open RAIL++-M</Hyperlink>), including its rules on harmful use.
                    </TextBlock>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="32,14" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
            <ui:Button HorizontalAlignment="Right" Appearance="Primary" Content="Get started" Padding="24,8"
                       Command="{Binding FinishCommand}" IsEnabled="{Binding CanFinish}" />
        </Border>
    </Grid>
</ui:FluentWindow>
