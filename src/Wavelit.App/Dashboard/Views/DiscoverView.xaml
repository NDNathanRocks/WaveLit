<UserControl x:Class="Wavelit.App.Dashboard.Views.DiscoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Wavelit.App.Dashboard.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DiscoverViewModel}">
    <Grid Margin="28,20,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,8,16">
            <TextBlock Text="Discover" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Search free 4K videos and live shaders, then set any of them as your wallpaper in one click."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,8,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="Search — try ocean, rain, neon, space…"
                        Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Search wallpapers">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <ToggleButton Content="Videos" IsChecked="{Binding IncludeVideos}" Padding="14,6" />
                <ToggleButton Content="Shaders" IsChecked="{Binding IncludeShaders}" Padding="14,6" Margin="6,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                <TextBlock Text="Apply to" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox MinWidth="170" ItemsSource="{Binding Context.Targets}" SelectedItem="{Binding Context.SelectedTarget}"
                          DisplayMemberPath="Label" AutomationProperties.Name="Apply to display" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Margin="0,0,8,8" Padding="14,10" CornerRadius="6"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                Visibility="{Binding SourceNotice, Converter={StaticResource NotEmptyToVisibility}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Add API keys" Appearance="Secondary" Command="{Binding OpenSettingsCommand}" />
                <ui:SymbolIcon Symbol="Info24" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SourceNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ListBox x:Name="ResultsList" Grid.Row="3" Style="{StaticResource CardGrid}"
                 ItemsSource="{Binding Results}" ItemTemplate="{StaticResource WallpaperCard}"
                 ScrollViewer.ScrollChanged="OnScrollChanged" AutomationProperties.Name="Search results" />

        <ui:ProgressRing Grid.Row="3" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding IsInitialLoading, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Row="3" Text="{Binding EmptyMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" FontSize="15"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding EmptyMessage, Converter={StaticResource NotEmptyToVisibility}}" />

        <TextBlock Grid.Row="4" Margin="0,8,8,12" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <Hyperlink NavigateUri="https://www.pexels.com" RequestNavigate="OnLink">Videos provided by Pexels</Hyperlink>
            <Run Text=" · " />
            <Hyperlink NavigateUri="https://www.shadertoy.com" RequestNavigate="OnLink">Shaders from Shadertoy</Hyperlink>
            <Run Text=" · Shadertoy shaders belong to their authors (CC BY-NC-SA 3.0 unless stated)." />
        </TextBlock>
    </Grid>
</UserControl>
