<UserControl x:Class="Wavelit.App.Dashboard.Views.CreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Wavelit.App.Dashboard.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CreateViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,80" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Create" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Describe a wallpaper and Wavelit paints it to fit your screens." Style="{StaticResource PageSubtitle}" />

            <!-- Prompt -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" MaxLength="400"
                            PlaceholderText="e.g. a cozy cabin in a snowy forest at night, warm windows, northern lights"
                            Icon="{ui:SymbolIcon Sparkle24}" AutomationProperties.Name="Describe your wallpaper">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding GenerateCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <ui:Button Appearance="Primary" Content="Create" Icon="{ui:SymbolIcon Sparkle24}" Padding="18,8"
                               Command="{Binding GenerateCommand}" />
                    <ui:Button Content="Stop" Margin="6,0,0,0" Command="{Binding CancelCommand}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>

            <!-- Ideas -->
            <ItemsControl ItemsSource="{Binding Ideas}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button Content="{Binding}" Margin="0,0,6,6" Padding="10,4" FontSize="12" Appearance="Secondary"
                                   Command="{Binding DataContext.UseIdeaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Options -->
            <WrapPanel Margin="0,8,0,0">
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Style" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <ComboBox Width="180" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" DisplayMemberPath="Label"
                              AutomationProperties.Name="Style" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Made by" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <ComboBox Width="220" ItemsSource="{Binding Generators}" SelectedItem="{Binding SelectedGenerator}" DisplayMemberPath="Label"
                              AutomationProperties.Name="Generator" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Motion" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <ComboBox Width="160" ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}" DisplayMemberPath="Label"
                              AutomationProperties.Name="Motion effect" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="Apply to" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <ComboBox MinWidth="170" ItemsSource="{Binding Context.Targets}" SelectedItem="{Binding Context.SelectedTarget}"
                              DisplayMemberPath="Label" AutomationProperties.Name="Apply to display" />
                </StackPanel>
            </WrapPanel>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                <Run Text="{Binding SelectedGenerator.Description, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ShapeText, Mode=OneWay}" />
            </TextBlock>

            <!-- Setup needed -->
            <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    Visibility="{Binding NeedsCloudflareKey, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Open Settings" Command="{Binding OpenSettingsCommand}" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Add your free Cloudflare account ID and API token in Settings to use this generator." />
                </DockPanel>
            </Border>
            <ContentControl Margin="0,14,0,0" Content="{Binding LocalAi}" Focusable="False"
                            Visibility="{Binding NeedsLocalSetup, Converter={StaticResource BoolToVisibility}}" />

            <!-- Progress & messages -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Height="4" Maximum="100" Value="{Binding Progress}" />
                <TextBlock Margin="0,6,0,0" Text="{Binding Stage}" Style="{StaticResource Caption}" />
            </StackPanel>
            <TextBlock Margin="0,12,0,0" Text="{Binding Message}" TextWrapping="Wrap"
                       Visibility="{Binding Message, Converter={StaticResource NotEmptyToVisibility}}" />

            <!-- Results -->
            <ItemsControl ItemsSource="{Binding Results}" Margin="0,16,0,0"
                          Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CreationResultViewModel}">
                        <Border Margin="0,0,12,12" CornerRadius="8" ClipToBounds="True"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="300" />
                                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                           Appearance="Primary" Content="Set as wallpaper" Icon="{ui:SymbolIcon Checkmark24}"
                                           Command="{Binding UseCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Tip: describe a place, the light and the mood. Images of real people and logos are best avoided. Everything you keep is saved in your Library." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
