<UserControl x:Class="Wavelit.App.Dashboard.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Wavelit.App.Dashboard.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AboutViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,80" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/wavelit-256.png" Width="72" Height="72" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Wavelit" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}">
                        <Run Text="Version" />
                        <Run Text="{Binding Version, Mode=OneWay}" />
                        <Run Text=" · Live wallpapers for Windows" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Credits" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Icon="{ui:SymbolIcon Video24}" Margin="0,0,0,4" Header="Videos provided by Pexels">
                <ui:Button Content="pexels.com" Appearance="Transparent" Command="{Binding OpenLinkCommand}" CommandParameter="https://www.pexels.com" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Sparkle24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Shaders from Shadertoy" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Each shader belongs to its author and is licensed CC BY-NC-SA 3.0 unless the author says otherwise. Open a card's source page to see its author and license." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="shadertoy.com" Appearance="Transparent" Command="{Binding OpenLinkCommand}" CommandParameter="https://www.shadertoy.com" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Code24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Open source" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Built with .NET, WPF-UI (MIT), Microsoft Edge WebView2, H.NotifyIcon (MIT), CommunityToolkit.Mvvm (MIT), VirtualizingWrapPanel (MIT) and Serilog (Apache-2.0)." />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <TextBlock Text="Privacy" Style="{StaticResource SectionHeader}" />
            <TextBlock Style="{StaticResource Caption}" FontSize="13"
                       Text="Wavelit has no account, no telemetry and no ads. It only talks to Pexels and Shadertoy when you search, using your own API keys, which are encrypted on this PC." />

            <TextBlock Text="Resource usage" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Icon="{ui:SymbolIcon Gauge24}">
                <ui:CardControl.Header>
                    <TextBlock Text="{Binding Stats}" Style="{StaticResource Caption}" FontSize="13" />
                </ui:CardControl.Header>
                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshStatsCommand}" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
