<UserControl x:Class="Wavelit.App.Dashboard.Views.OverlaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Wavelit.App.Dashboard.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:OverlaysViewModel}"
             IsVisibleChanged="OnVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="OverlayCardItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Width="216" Margin="0,0,14,14" CornerRadius="10" BorderThickness="1.5"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <Border Height="135" CornerRadius="9,9,0,0" ClipToBounds="True" Background="#1B1F3B">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Margin="12,9,12,11">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding Description}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Height="32"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,80" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Overlays" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="A subtle layer over any wallpaper. Pick one and move your mouse over the desktop: it applies instantly and only runs while the wallpaper is visible." />

            <ListBox Margin="0,20,0,0" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}"
                     ItemContainerStyle="{StaticResource OverlayCardItem}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Overlays">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <ui:CardControl Icon="{ui:SymbolIcon Layer24}" Margin="0,6,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Only for this wallpaper" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                            <Run Text="Keep this overlay with " /><Run Text="{Binding CurrentWallpaperName, Mode=OneWay}" /><Run Text=" only; other wallpapers use your usual choice." />
                        </TextBlock>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding OnlyThisWallpaper}" AutomationProperties.Name="Only for this wallpaper" />
            </ui:CardControl>

            <StackPanel Visibility="{Binding HasOverlay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Fine-tune" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Icon="{ui:SymbolIcon Sparkle24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Amount" FontWeight="SemiBold" />
                            <TextBlock Text="From a few quiet specks to a lively scene." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Slider Width="220" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding Amount, Delay=200}" AutomationProperties.Name="Amount" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon ResizeLarge24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <TextBlock Text="Size" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </ui:CardControl.Header>
                    <Slider Width="220" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding Size, Delay=200}" AutomationProperties.Name="Size" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon TopSpeed24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <TextBlock Text="Speed" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </ui:CardControl.Header>
                    <Slider Width="220" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding Speed, Delay=200}" AutomationProperties.Name="Speed" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Eye24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <TextBlock Text="Opacity" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </ui:CardControl.Header>
                    <Slider Width="220" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding Opacity, Delay=200}" AutomationProperties.Name="Opacity" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Color24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Colour" FontWeight="SemiBold" />
                            <TextBlock Text="Natural uses each overlay's own light." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox Width="220" ItemsSource="{Binding Colors}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedColor}" AutomationProperties.Name="Colour" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon CursorHover24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Cursor response" FontWeight="SemiBold" />
                            <TextBlock Text="How much the overlay reacts when your mouse is over the desktop." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox Width="220" ItemsSource="{Binding Responses}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedResponse}" AutomationProperties.Name="Cursor response" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon CursorClick24}" Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Click bursts" FontWeight="SemiBold" />
                            <TextBlock Text="Clicking on the empty desktop sends out a little burst." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ClickBursts}" AutomationProperties.Name="Click bursts" />
                </ui:CardControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
