<UserControl x:Class="Wavelit.App.Dashboard.Views.StudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Wavelit.App.Dashboard.ViewModels"
             xmlns:controls="clr-namespace:Wavelit.App.Dashboard.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:StudioViewModel}">
    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header and tabs -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Studio" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Describe a wallpaper and Wavelit makes it: a picture, a live wallpaper or an overlay, shaped to your screens."
                       Style="{StaticResource PageSubtitle}" />
            <ListBox Style="{StaticResource ChipRow}" Margin="0,14,0,14" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                     AutomationProperties.Name="What to make" />
        </StackPanel>

        <!-- Picture: the image generators -->
        <ContentControl Grid.Row="1" Content="{Binding Picture}" Focusable="False"
                        Visibility="{Binding IsPicture, Converter={StaticResource BoolToVisibility}}" />

        <!-- Live wallpaper / Overlay -->
        <Grid Grid.Row="1" Visibility="{Binding IsShaderTab, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: describe, options, refine, history -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding UseRecipe}" OnContent="Recipe" OffContent="Free writing"
                                                 AutomationProperties.Name="Use a recipe" ToolTip="A fill-in sentence with suggestions, or write it in your own words" />
                                <TextBlock Text="Describe it" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Recipe: a fill-in sentence; every slot takes a suggestion or your own words -->
                            <StackPanel Visibility="{Binding UseRecipe, Converter={StaticResource BoolToVisibility}}">
                                <WrapPanel>
                                    <WrapPanel.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="0,0,6,8" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="IsEditable" Value="True" />
                                            <Setter Property="Margin" Value="0,0,6,8" />
                                            <Setter Property="MinWidth" Value="104" />
                                        </Style>
                                    </WrapPanel.Resources>
                                    <TextBlock Text="A" />
                                    <ComboBox Width="190" ItemsSource="{x:Static vm:StudioViewModel.RecipeSubjects}" AutomationProperties.Name="Subject"
                                              Text="{Binding RecipeSubject, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="What it is: pick one or type your own" />
                                    <TextBlock Text="that" />
                                    <ComboBox ItemsSource="{x:Static vm:StudioViewModel.RecipeMotions}" AutomationProperties.Name="Motion"
                                              Text="{Binding RecipeMotion, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    <TextBlock Text=", in a" />
                                    <ComboBox ItemsSource="{x:Static vm:StudioViewModel.RecipeMoods}" AutomationProperties.Name="Mood"
                                              Text="{Binding RecipeMood, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    <TextBlock Text="mood, lit by" />
                                    <ComboBox Width="140" ItemsSource="{x:Static vm:StudioViewModel.RecipeLights}" AutomationProperties.Name="Light"
                                              Text="{Binding RecipeLight, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    <TextBlock Text=". Detail:" />
                                    <ComboBox ItemsSource="{x:Static vm:StudioViewModel.RecipeDetails}" AutomationProperties.Name="Detail"
                                              Text="{Binding RecipeDetail, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    <TextBlock Text=". Avoid:" />
                                    <ui:TextBox Width="190" Margin="0,0,0,8" MaxLength="80" PlaceholderText="e.g. text, faces, flashing"
                                                Text="{Binding RecipeAvoid, UpdateSourceTrigger=PropertyChanged, Delay=250}" AutomationProperties.Name="Avoid" />
                                </WrapPanel>
                                <Border Margin="0,2,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        Visibility="{Binding Prompt, Converter={StaticResource NotEmptyToVisibility}}">
                                    <TextBlock Text="{Binding RecipeSentence}" TextWrapping="Wrap" FontStyle="Italic" AutomationProperties.Name="Your recipe" />
                                </Border>
                            </StackPanel>

                            <!-- Free writing -->
                            <StackPanel Visibility="{Binding UseRecipe, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <ui:TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" MaxLength="400"
                                        PlaceholderText="{Binding Placeholder}" TextWrapping="Wrap" AcceptsReturn="False"
                                        MinHeight="76" VerticalContentAlignment="Top"
                                        AutomationProperties.Name="Describe it">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CreateCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                            <TextBlock Text="{Binding PromptHint}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Visibility="{Binding PromptHint, Converter={StaticResource NotEmptyToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Ideas}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="{Binding}" Margin="0,0,6,6" Padding="9,3" FontSize="11.5" Appearance="Secondary"
                                                   Command="{Binding DataContext.UseIdeaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>

                            <!-- Music tab -->
                            <StackPanel Visibility="{Binding IsAudioTab, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Reacts to" Style="{StaticResource Caption}" Margin="0,8,0,4" />
                                <ListBox Style="{StaticResource ChipRow}" ItemsSource="{x:Static vm:StudioViewModel.ReactsToChoices}"
                                         SelectedItem="{Binding SelectedReactsTo}" AutomationProperties.Name="Reacts to" />
                                <TextBlock Text="By" Style="{StaticResource Caption}" Margin="0,6,0,4" />
                                <ListBox Style="{StaticResource ChipRow}" ItemsSource="{x:Static vm:StudioViewModel.ReactsByChoices}"
                                         SelectedItem="{Binding SelectedReactsBy}" AutomationProperties.Name="Reacts by" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Text="The preview plays a built-in demo beat (nothing is heard). On your desktop it follows whatever your PC plays, never the microphone, and it never flashes." />
                            </StackPanel>

                            <TextBlock Text="Cursor" Style="{StaticResource Caption}" Margin="0,8,0,4" />
                            <ListBox Style="{StaticResource ChipRow}" ItemsSource="{x:Static vm:StudioViewModel.Interactivities}"
                                     SelectedItem="{Binding SelectedInteractivity}" AutomationProperties.Name="Cursor" />
                            <TextBlock Text="Palette" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                            <ListBox Style="{StaticResource ChipRow}" ItemsSource="{x:Static vm:StudioViewModel.Palettes}"
                                     SelectedItem="{Binding SelectedPalette}" AutomationProperties.Name="Palette">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChipItemStyle}">
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <TextBlock Text="Motion" Style="{StaticResource Caption}" Margin="0,4,0,4" />
                            <ListBox Style="{StaticResource ChipRow}" ItemsSource="{x:Static vm:StudioViewModel.Speeds}"
                                     SelectedItem="{Binding SelectedSpeed}" AutomationProperties.Name="Motion" />

                            <TextBlock Text="Made by" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding Authors}" SelectedItem="{Binding SelectedAuthor}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="Made by" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedAuthor.Description}" Style="{StaticResource Caption}" />

                            <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="Settings" Margin="8,0,0,0" Command="{Binding OpenSettingsCommand}" />
                                    <TextBlock Text="{Binding SetupText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- Create (API authors) -->
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                        Visibility="{Binding IsPaste, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <ui:Button Appearance="Primary" Content="Create" Icon="{ui:SymbolIcon Sparkle24}" Padding="18,8"
                                           Command="{Binding CreateCommand}" />
                                <ui:Button Content="Surprise me" Margin="8,0,0,0" Icon="{ui:SymbolIcon Lightbulb24}" Command="{Binding SurpriseMeCommand}" />
                                <ui:Button Content="Stop" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <!-- Any AI chat: copy the prompt, paste the answer -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding IsPaste, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Caption}" Text="1. Copy this prompt into any AI chat (it includes your idea and options)." />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                                    <ui:Button Appearance="Primary" Content="Copy prompt" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyChatPromptCommand}" />
                                    <ui:Button Content="Surprise me" Margin="8,0,0,0" Icon="{ui:SymbolIcon Lightbulb24}" Command="{Binding SurpriseMeCommand}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="2. Paste the AI's whole answer here." />
                                <ui:TextBox Margin="0,6,0,0" Text="{Binding PastedReply, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MaxLength="200000"
                                            TextWrapping="NoWrap" MinHeight="90" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                            PlaceholderText="Paste the answer (with its code block)" AutomationProperties.Name="The AI's answer" />
                                <ui:Button Margin="0,8,0,0" Content="Check &amp; preview" Icon="{ui:SymbolIcon Play24}" Command="{Binding CheckPastedCommand}" />
                            </StackPanel>

                            <!-- Progress and messages -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar Height="4" IsIndeterminate="True" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding Stage}" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Text="{Binding Message}" TextWrapping="Wrap"
                                       Visibility="{Binding Message, Converter={StaticResource NotEmptyToVisibility}}" />
                            <StackPanel Margin="0,6,0,0" Visibility="{Binding SendBackText, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBox Text="{Binding SendBackText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto" FontSize="11" AutomationProperties.Name="Message for your AI chat" />
                                <ui:Button Margin="0,6,0,0" Content="Copy" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopySendBackCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Refine -->
                    <Border Style="{StaticResource CardBorder}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Refine" FontWeight="SemiBold" />
                            <TextBlock Text="Change what's showing, e.g. slower, more purple, fewer particles." Style="{StaticResource Caption}" Margin="0,2,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding RefineNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                            PlaceholderText="What should change?" AutomationProperties.Name="Refine">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding RefineCommand}" />
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Refine" Command="{Binding RefineCommand}"
                                           Visibility="{Binding IsPaste, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Static vm:StudioViewModel.RefineIdeas}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="{Binding}" Margin="0,0,6,6" Padding="9,3" FontSize="11.5" Appearance="Secondary"
                                                   Command="{Binding DataContext.UseRefineIdeaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Caption}" Visibility="{Binding IsPaste, Converter={StaticResource BoolToVisibility}}"
                                       Text="With an AI chat: write the change, then copy the prompt again. It now includes the current code." />
                        </StackPanel>
                    </Border>

                    <!-- History -->
                    <StackPanel Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Your creations" Style="{StaticResource SectionHeader}" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StudioHistoryItem}">
                                    <Button Margin="0,0,8,8" Padding="0" Width="108" Height="61" ToolTip="{Binding Tooltip}" Cursor="Hand"
                                            AutomationProperties.Name="{Binding Entry.Title}"
                                            Command="{Binding DataContext.OpenHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="6" ClipToBounds="True" BorderThickness="1" x:Name="Frame"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        <TextBlock Text="{Binding Entry.Title}" FontSize="10" Margin="5,0,5,3" VerticalAlignment="Bottom"
                                                                   Foreground="White" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.9" />
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Remix (load its idea and options)"
                                                          Command="{Binding PlacementTarget.Tag.RemixCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Remove from history"
                                                          Command="{Binding PlacementTarget.Tag.RemoveHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.Tag>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </Button.Tag>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: live preview and actions (outside any ScrollViewer: the preview is a native window) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="8" ClipToBounds="True" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="#0B0B10">
                    <Grid>
                        <!-- The preview page draws its own empty state; it stays loaded because it also checks every shader.
                             Hidden (not collapsed) while the code shows, so the browser keeps its window. -->
                        <controls:StudioPreview x:Name="Preview">
                            <controls:StudioPreview.Style>
                                <Style TargetType="controls:StudioPreview">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowCode}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:StudioPreview.Style>
                        </controls:StudioPreview>
                        <TextBox Visibility="{Binding ShowCode, Converter={StaticResource BoolToVisibility}}" Text="{Binding Current.Code, Mode=OneWay}"
                                 IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="#0B0B10" Foreground="#E6FFFFFF" BorderThickness="0" AutomationProperties.Name="Shader code" />
                    </Grid>
                </Border>

                <!-- Result bar: title and speed, then options on the left and actions on the right (wrapping) -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Margin="10,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                Visibility="{Binding SpeedBadge, Converter={StaticResource NotEmptyToVisibility}}"
                                ToolTip="Measured on your graphics card at 1920 × 1080 before it was shown.">
                            <TextBlock Text="{Binding SpeedBadge}" FontSize="11" />
                        </Border>
                        <TextBlock Text="{Binding Current.Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Current.Description}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Current.Description, Converter={StaticResource NotEmptyToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Padding="8,2" CornerRadius="10" VerticalAlignment="Center" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                ToolTip="{Binding Current.Model, StringFormat=Written by {0}. The prompt and model are kept with it.}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle16" FontSize="12" Margin="0,0,4,0" />
                                <TextBlock Text="Made with AI" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <ui:Button Margin="8,0,0,0" Padding="8,2" FontSize="11" Appearance="Transparent" Icon="{ui:SymbolIcon Flag16}" Content="Report"
                                   Command="{Binding StartReportCommand}" ToolTip="Report a problem with this AI creation" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding LastRunCost}"
                                   Visibility="{Binding LastRunCost, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>

                    <!-- Report (Microsoft Store 11.16): opens a pre-filled issue in the browser; nothing is sent from here -->
                    <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding IsReporting, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Report this creation" FontWeight="SemiBold" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{x:Static vm:StudioViewModel.ReportReasons}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding ReportReason}" AutomationProperties.Name="Reason" />
                            <ui:TextBox Margin="0,8,0,0" MaxLength="500" PlaceholderText="Anything else? (optional)" Text="{Binding ReportNote, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Margin="0,8,0,0" Content="Include the prompt and code" IsChecked="{Binding ReportIncludeDetails}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="Your browser opens a public GitHub report with these details filled in. Nothing is sent until you submit it there." />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:Button Appearance="Primary" Content="Open report" Icon="{ui:SymbolIcon Open24}" Command="{Binding SendReportCommand}" />
                                <ui:Button Margin="8,0,0,0" Content="Cancel" Command="{Binding CancelReportCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sliders the AI offered (tweak without asking again) -->
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Sliders}" Visibility="{Binding HasSliders, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ParamSlider}">
                                <DockPanel Margin="0,0,14,2">
                                    <TextBlock DockPanel.Dock="Left" Width="74" Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                                            Value="{Binding Value, Delay=80}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                            <CheckBox Content="Both screens" IsChecked="{Binding BothScreens}" Margin="0,0,12,0"
                                      Visibility="{Binding HasSeveralScreens, Converter={StaticResource BoolToVisibility}}"
                                      ToolTip="Preview it across your real monitor layout" />
                            <CheckBox Content="Show code" IsChecked="{Binding ShowCode}" />
                        </StackPanel>
                        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:Button Content="Copy code" Margin="0,0,8,6" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyCodeCommand}"
                                       Visibility="{Binding ShowCode, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Content="Save to Library" Margin="0,0,8,6" Command="{Binding SaveToLibraryCommand}"
                                       Visibility="{Binding IsWallpaperResult, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Appearance="Primary" Content="Set as wallpaper" Icon="{ui:SymbolIcon Checkmark24}" Margin="0,0,0,6"
                                       Command="{Binding SetAsWallpaperCommand}"
                                       Visibility="{Binding IsWallpaperResult, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Appearance="Primary" Content="Use as overlay" Icon="{ui:SymbolIcon Layer24}" Margin="0,0,0,6"
                                       Command="{Binding UseAsOverlayCommand}"
                                       Visibility="{Binding IsOverlayResult, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
