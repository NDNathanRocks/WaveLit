<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local AI image generator. A separate process so the multi-GB model never lives in the wallpaper app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Wavelit.Create</RootNamespace>
    <AssemblyName>Wavelit.Create</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- DirectML.dll is only copied for an explicit platform; ship the newer one rather than rely on System32's. -->
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' != 'win-arm64'">x64</PlatformTarget>
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>true</Microsoft_AI_DirectML_SkipDebugLayerCopy>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wavelit.Core\Wavelit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships with the app (4.8 MB, BSD-3): sharpens every creation to full screen size. -->
    <None Include="Models/realesrgan-x4/model.onnx;Models/realesrgan-x4/model.data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
