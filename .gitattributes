# Normalise text files in the repository; Windows checkouts get CRLF.
* text=auto
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.props text eol=crlf
*.js text eol=crlf
*.html text eol=crlf
*.css text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.yml text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.ico binary
*.onnx binary
