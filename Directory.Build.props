<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CA1848/CA1873: LoggerMessage source-gen is overkill for this app's log volume.
         CA1416: everything here is Windows-only by design.
         SYSLIB1054: classic DllImport is used for callback-heavy user32 interop. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1416;SYSLIB1054;CA1515;CA1031;CA2007;CA1303;CA1812;CA1001;CA1063;CA1716;CA1720;CA1724;CA1819;CA1002;CA2227;CA1056;CA1054;CA1055;CA1062;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA5394;CA1814;CA1508;CA1806;CA1401;CA1822;CA1826;CA1051;CA1815;CA2101;CA1838;CA1034;CA1711;CA1003;CA1024;CA1860;CA1859</NoWarn>
    <Version>0.1.0</Version>
    <Company>Wavelit</Company>
    <Product>Wavelit</Product>
    <Copyright>Copyright © 2026 Nathan Dsouza</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
